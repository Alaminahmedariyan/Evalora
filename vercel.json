{
	"version": 2,
	"builds": [
		{
			"src": "dist/server.js",
			"use": "@vercel/node"
		}
	],
	"routes": [
		{
			"src": "/api/v1/webhooks/(.*)",
			"dest": "dist/server.js"
		},
		{
			"src": "/api/auth/(.*)",
			"dest": "dist/server.js"
		},
		{
			"src": "/api/v1/(.*)",
			"dest": "dist/server.js"
		},
		{
			"src": "/health",
			"dest": "dist/server.js"
		},
		{
			"src": "/(.*)",
			"dest": "dist/server.js"
		}
	],
	"env": {
		"NODE_ENV": "production"
	}
}
