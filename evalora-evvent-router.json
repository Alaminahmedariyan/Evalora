    {
      "id": "7d95b7ef-8859-43cc-a02e-4939ce1b9231",
      "name": "Build heuristic report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        400
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json.data.proctoring;\nreturn [{ json: { riskLevel: d.heuristicRiskLevel, riskSummary: 'Rule-based risk score ' + d.heuristicRiskScore + ' (' + d.tabSwitchCount + ' tab switches).', aiModel: 'heuristic' } }];"
      }
    },
