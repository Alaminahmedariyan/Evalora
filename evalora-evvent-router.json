      "name": "AI eligible?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "869ed88f-9ebb-4a21-ad8b-40f42b07a4e8",
              "leftValue": "={{ String($json.data.eligible) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a908b7ad-523e-4f24-9155-933146abe462",
      "name": "Gemini grade",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: 'You grade a written answer. Reply as JSON {\"aiScore\": integer 0-' + $json.data.maxScore + ', \"aiFeedback\": short string}. Question: ' + $json.data.question + ' Rubric: ' + ($json.data.rubric || 'none') + ' Answer: ' + $json.data.answer }] }], generationConfig: { responseMimeType: 'application/json', temperature: 0.2 } }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "03f407ae-8c93-4243-b457-4955edc7a95e",
      "name": "Parse grade",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        -80
      ],
      "parameters": {
        "jsCode": "const input = $('Get AI input').first().json.data;\nconst raw = $input.first().json.candidates[0].content.parts[0].text;\nconst parsed = JSON.parse(raw);\nconst score = Math.max(0, Math.min(input.maxScore, Math.round(Number(parsed.aiScore) || 0)));\nreturn [{ json: { aiScore: score, aiFeedback: String(parsed.aiFeedback || '').slice(0, 2000), aiModel: 'gemini-2.0-flash' } }];"
      }
    },
    {
      "id": "6f78ab95-8bd4-499b-8f58-9ee7db0bd7fb",
      "name": "Save AI result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://evalora-server.vercel.app/api/v1/internal/automation/submissions/{{ $('Webhook').first().json.body.aggregateId }}/ai-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
