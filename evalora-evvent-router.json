    {
      "id": "44dc0ed7-5987-4b2d-90b7-da5d9621472a",
      "name": "Gemini report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: 'You review a finished online assessment. Reply as JSON {\"riskLevel\": \"LOW\"|\"MEDIUM\"|\"HIGH\", \"riskSummary\": string, \"summary\": string, \"strengths\": string[], \"weaknesses\": string[], \"recommendation\": string}. Base riskLevel mainly on the heuristic level and say why. Data: ' + JSON.stringify($json.data) }] }], generationConfig: { responseMimeType: 'application/json', temperature: 0.2 } }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "3882ffac-5dd6-4c39-9b8d-6aae8dc6c825",
      "name": "Parse report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        220
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst p = JSON.parse(raw);\nconst level = ['LOW', 'MEDIUM', 'HIGH'].includes(p.riskLevel) ? p.riskLevel : 'LOW';\nreturn [{ json: { riskLevel: level, riskSummary: String(p.riskSummary || 'No summary.').slice(0, 1000), summary: String(p.summary || '').slice(0, 2000), strengths: (p.strengths || []).slice(0, 10).map(String), weaknesses: (p.weaknesses || []).slice(0, 10).map(String), recommendation: String(p.recommendation || '').slice(0, 1000), aiModel: 'gemini-2.0-flash' } }];"
      }
    },
    {
      "id": "4e03ff30-cb9a-4eb3-877f-d5b082e0c9e4",
      "name": "Save report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://evalora-server.vercel.app/api/v1/internal/automation/attempts/{{ $('Webhook').first().json.body.aggregateId }}/report-result",
        "sendHeaders": true,
        "headerParameters": {
