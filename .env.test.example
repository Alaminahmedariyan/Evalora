# Copy this file to `.env.test` (which is git-ignored) and fill in real values.

# Required guard — must be exactly "evalora-test-branch" or tests refuse to run.
NODE_ENV=test
TEST_DB_MARKER=evalora-test-branch

# Neon test branch (UNPOOLED — do NOT use a "-pooler" host here).
# TODO(Phase 5c): before upgrading to pg@9, change `sslmode=require` to
# `sslmode=verify-full` (or add `uselibpqcompat=true&sslmode=require`). pg-connection-string
# v3 / pg v9 will stop treating `require` as an alias for `verify-full`.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

# Optional in dev/test, but used for session signing in tests (min 32 chars).
BETTER_AUTH_SECRET=test-secret-minimum-32-characters-long-xyz

# Required by src/app/config (CLIENT_URL is validated as a URL).
CLIENT_URL=http://localhost:3000

# Required by src/app/config (SUPER_ADMIN_EMAIL/PASSWORD are required fields).
SUPER_ADMIN_EMAIL=test@evalora.local
SUPER_ADMIN_PASSWORD=TestPassword123!

# SMTP placeholders (real config keys: EMAIL_FROM / SMTP_USER / SMTP_PASSWORD).
# No real email is ever sent — tests mock the email senders.
SMTP_USER=test@example.com
SMTP_PASSWORD=test-placeholder
EMAIL_FROM=noreply@evalora.local

# Optional in test (Redis is mocked in tests/setup.ts, so this is unused).
REDIS_URL=